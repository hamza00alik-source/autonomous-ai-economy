# Optional integrations are intentionally unset in Phase 1.
# Never paste secrets into this file or commit a populated .env.
ECONOMY_MODE=simulation
LOG_LEVEL=INFO

# Generate a random secret locally (at least 32 bytes) and keep it only in .env.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
ECONOMY_OWNER_APPROVAL_SECRET=

# Separate purpose-bound secret for listing publication approvals.
ECONOMY_CATALOG_APPROVAL_SECRET=

# Purpose-bound owner approvals for high-risk policy decisions (never reuse other secrets).
ECONOMY_ACTION_APPROVAL_SECRET=
