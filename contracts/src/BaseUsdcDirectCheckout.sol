pragma solidity ^0.8.24;

/// @notice Direct-pay checkout for AAE digital orders on Base mainnet.
/// @dev This contract never holds buyer funds: USDC is transferred directly
///      from the buyer to the immutable merchant recipient.
interface IERC20BaseUsdc {
    function balanceOf(address account) external view returns (uint256);
    function transferFrom(address from, address to, uint256 value) external returns (bool);
}

contract BaseUsdcDirectCheckout {
    address public constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
    uint256 public constant BASE_MAINNET_CHAIN_ID = 8453;

    address public immutable merchant;
    mapping(bytes32 => bool) public paidOrder;

    event OrderPaid(
        bytes32 indexed orderId,
        address indexed buyer,
        address indexed merchant,
        uint256 amount,
        address token
    );

    error WrongNetwork();
    error InvalidMerchant();
    error InvalidOrderId();
    error InvalidAmount();
    error AlreadyPaid();
    error TokenCallFailed();
    error IncorrectTransferAmount();

    constructor(address merchant_) {
        if (block.chainid != BASE_MAINNET_CHAIN_ID) revert WrongNetwork();
        if (merchant_ == address(0)) revert InvalidMerchant();
        merchant = merchant_;
    }

    /// @notice Pay an exact invoice amount. Buyer must first approve this contract.
    /// @param orderId Unique random 32-byte identifier generated by AAE per invoice.
    /// @param amount Exact USDC base units (USDC has 6 decimals).
    function pay(bytes32 orderId, uint256 amount) external {
        if (orderId == bytes32(0)) revert InvalidOrderId();
        if (amount == 0) revert InvalidAmount();
        if (paidOrder[orderId]) revert AlreadyPaid();

        IERC20BaseUsdc token = IERC20BaseUsdc(BASE_USDC);
        uint256 beforeBalance = token.balanceOf(merchant);
        bool ok = token.transferFrom(msg.sender, merchant, amount);
        if (!ok) revert TokenCallFailed();
        uint256 afterBalance = token.balanceOf(merchant);
        if (afterBalance < beforeBalance || afterBalance - beforeBalance != amount) {
            revert IncorrectTransferAmount();
        }

        paidOrder[orderId] = true;
        emit OrderPaid(orderId, msg.sender, merchant, amount, BASE_USDC);
    }
}
